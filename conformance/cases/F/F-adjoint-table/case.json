 "object": "../../objects/qinplace.bisa",
 "command": [
  "run-action",
  "{object}",
  "inc_inplace",
  "--mut",
  "0",
  "--arg",
  "token:10,0,0,0",
  "--adjoint"
 ],
 "expect": {
  "exit": 0,
  "stdout_json": {
   "mut": [
    3
   ],
   "state": {
    "11": [
     1,
     0
    ]
   }
  },
  "stdout_json_exact_at": [
   "state"
  ]
 }
}
