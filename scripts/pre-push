#!/usr/bin/env bash
# Push gate (no CI): check out the commit being pushed (local sha from the refs git
# supplies on stdin; HEAD when run directly) into a temporary detached worktree and
# test exactly that tree, never the possibly dirty working tree (an editor may be
# mid-change while the orchestrator pushes). Runs cargo test in both crates, the
# 0.8-to-0.9 diff witness and the bound-catalog check. Exit status is the gate's.
set -euo pipefail
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE
script_dir="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
root="$(git -C "$script_dir" rev-parse --show-toplevel)"
unset DISPLAY WAYLAND_DISPLAY DBUS_SESSION_BUS_ADDRESS BROWSER
shas=()
if [ ! -t 0 ]; then
  while read -r -t 10 _ref sha _rref _rsha; do
    case "$sha" in ''|*[!0-9a-f]*|0000000000000000000000000000000000000000) continue;; esac
    shas+=("$sha")
  done || true
fi
if [ "${#shas[@]}" -eq 0 ]; then shas=("$(git -C "$root" rev-parse HEAD)"); fi
declare -A seen=()
status=0
for sha in "${shas[@]}"; do
  sha="$(git -C "$root" rev-parse --verify "${sha}^{commit}")"
  [ -n "${seen[$sha]:-}" ] && continue
  seen[$sha]=1
  # Beside the repo, not under .tmp: the witness script reaches the pinned review binary via
  # ../bennett-isa-spec-review relative to the repo root.
  wt="$(dirname "$root")/$(basename "$root")-gate-${sha:0:12}"
  cleanup() {
    git -C "$root" worktree remove --force "$wt" >/dev/null 2>&1 || true
    rm -rf "$wt"
    git -C "$root" worktree prune
  }
  cleanup
  mkdir -p "$root/.tmp/gate-target"
  trap cleanup EXIT
  git -C "$root" worktree add --detach "$wt" "$sha" >/dev/null
  echo "pre-push: gating $sha in $wt" >&2
  mkdir -p "$wt/.tmp"
  gate() {
    env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u DISPLAY -u WAYLAND_DISPLAY -u DBUS_SESSION_BUS_ADDRESS -u BROWSER \
        TMPDIR="$wt/.tmp" CARGO_TARGET_DIR="$root/.tmp/gate-target" "$@"
  }
  # The witness script and some tests address <crate>/target/debug/<bin>; point each
  # crate's target at the shared build cache so builds stay warm and those paths resolve.
  for crate in reference-interpreter conformance; do
    rm -rf "$wt/$crate/target"; ln -s "$root/.tmp/gate-target" "$wt/$crate/target"
  done
  run_gate() {
    echo "pre-push: cargo test in reference-interpreter" >&2 &&
    gate cargo test --offline --manifest-path "$wt/reference-interpreter/Cargo.toml" &&
    echo "pre-push: cargo test in conformance" >&2 &&
    gate cargo test --offline --manifest-path "$wt/conformance/Cargo.toml" &&
    echo "pre-push: diff witness and bound catalog" >&2 &&
    gate env -C "$wt" python3 -I conformance/tests/draft_witnesses.py &&
    gate env -C "$wt" python3 -I conformance/tools/ref_catalog.py --check
  }
  run_gate || status=$?
  cleanup
  trap - EXIT
  [ "$status" -eq 0 ] || break
done
exit "$status"
